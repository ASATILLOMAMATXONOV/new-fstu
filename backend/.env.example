# Optional server-side AI provider. Keep this key on the backend only.
# Security monitoring: apply migration 010 before starting this version.
# Comma-separated IPs/CIDRs of reverse proxies YOU control. Leave blank for direct connections.
# Never use true, * or a hop count. Your ingress must overwrite incoming forwarding headers.
TRUST_PROXY=
SECURITY_REQUEST_LIMIT=600
SECURITY_WRITE_LIMIT=30
SECURITY_BLOCK_MINUTES=15
SECURITY_RETENTION_DAYS=30
# A separate, persistent 32-byte encryption key, encoded as 64 hexadecimal characters.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this in server secrets/backups. Changing it prevents existing TOTP secrets from decrypting.
MFA_ENCRYPTION_KEY=
ADMIN_SESSION_MINUTES=120
ADMIN_SESSION_IDLE_MINUTES=20
# Attacker IP intelligence (geolocation, ISP/ASN, VPN/proxy/Tor/hosting). Apply migration 011.
# Uses ip-api.com (free tier: non-commercial, 45 lookups/min; results are cached 7 days).
# Set IP_API_KEY for the paid HTTPS endpoint, or SECURITY_IP_INTEL=off to disable lookups.
SECURITY_IP_INTEL=on
IP_API_KEY=
# IMPORTANT behind Render/nginx/Cloudflare: list the proxy addresses (e.g. 10.0.0.0/8, loopback),
# otherwise every visitor is seen as the proxy IP and forwarded headers are treated as untrusted.

OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini

# Natural conversational voice (uses OPENAI_API_KEY above; key stays on the server).
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
OPENAI_SPEECH_VOICE=marin
# OpenAI failures are reported instead of switching to a different voice.
# An API key needs an active API credit balance (separate from a ChatGPT subscription).

# Optional natural Uzbek, Russian and English cloud voices. Local speech works without keys.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=uz-UZ-MadinaNeural
AZURE_SPEECH_VOICE_UZ=uz-UZ-MadinaNeural
AZURE_SPEECH_VOICE_RU=ru-RU-SvetlanaNeural
AZURE_SPEECH_VOICE_EN=en-US-JennyNeural
# Assistant voice: OpenAI tabiiy ovoz ustun. Agar OpenAI kvotasi tugasa yoki ishlamasa,
# 'local' qiymati offline eSpeak o'zbek ovoziga o'tishga ruxsat beradi (internetsiz ishlaydi).
# Bo'sh qoldirilsa: OpenAI kaliti bor bo'lsa faqat OpenAI ishlatiladi va xatolik xabar qilinadi.
ASSISTANT_SPEECH_FALLBACK=local
# Admin uchun ikki bosqichli autentifikatsiya (MFA). true (standart) = authenticator ilovasi majburiy.
# false = faqat login+parol (birinchi/zaif kirishda bir martalik parol almashtirish bilan).
ADMIN_MFA_REQUIRED=true
