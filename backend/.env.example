# Optional server-side AI provider. Keep this key on the backend only.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini

# Natural conversational voice (uses OPENAI_API_KEY above; key stays on the server).
OPENAI_SPEECH_MODEL=gpt-realtime-2.1-mini
OPENAI_SPEECH_VOICE=marin
# OpenAI failures are reported instead of switching to a different voice.
# An API key needs an active API credit balance (separate from a ChatGPT subscription).

# Optional natural Uzbek, Russian and English cloud voices. Local speech works without keys.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=uz-UZ-MadinaNeural
AZURE_SPEECH_VOICE_UZ=uz-UZ-MadinaNeural
AZURE_SPEECH_VOICE_RU=ru-RU-SvetlanaNeural
AZURE_SPEECH_VOICE_EN=en-US-JennyNeural
