{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "api": ["./src/api"],
      "api/*": ["./src/api/*"],
      "assets": ["./src/assets"],
      "assets/*": ["./src/assets/*"],
      "components": ["./src/components"],
      "components/*": ["./src/components/*"],
      "config": ["./src/config.js"],
      "constants": ["./src/constants"],
      "constants/*": ["./src/constants/*"],
      "contexts": ["./src/contexts"],
      "contexts/*": ["./src/contexts/*"],
      "hooks": ["./src/hooks"],
      "hooks/*": ["./src/hooks/*"],
      "layout": ["./src/layout"],
      "layout/*": ["./src/layout/*"],
      "menu-items": ["./src/menu-items/index.jsx"],
      "menu-items/*": ["./src/menu-items/*"],
      "pages": ["./src/pages"],
      "pages/*": ["./src/pages/*"],
      "routes": ["./src/routes/index.jsx"],
      "routes/*": ["./src/routes/*"],
      "sections": ["./src/sections"],
      "sections/*": ["./src/sections/*"],
      "themes": ["./src/themes/index.jsx"],
      "themes/*": ["./src/themes/*"],
      "utils": ["./src/utils"],
      "utils/*": ["./src/utils/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
